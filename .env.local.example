# Admin
ADMIN_PASSWORD=your_admin_password
ADMIN_PASSWORD_HASH=<generated by scripts/seed.ts>

# JWT
JWT_SECRET=random_64_char_string_generated_by_openssl

# Tencent COS
COS_SECRET_ID=your_tencent_secret_id
COS_SECRET_KEY=your_tencent_secret_key
COS_BUCKET=your-bucket-1234567890
COS_REGION=ap-guangzhou

# Database (optional — defaults to ./data.db)
DATABASE_PATH=./data.db
